<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Demo.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="appsettings.Secrets.json;appsettings.Local.json;data/**" />
    <None Update="appsettings.Secrets.json;appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <!-- The demo's only local persistence: the visitor registry / allow-deny
         store (DemoStore.cs). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <!-- Explicit bump past the GHSA-2m69-gcr7-jv3q advisory in the transitive
         SQLitePCLRaw 2.1.x that Microsoft.Data.Sqlite still pins. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- MX lookups for gate email validation (GateService/Gate page). -->
    <PackageReference Include="DnsClient" Version="1.8.0" />
  </ItemGroup>

</Project>
