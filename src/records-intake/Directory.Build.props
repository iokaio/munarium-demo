<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><MunariumRoot Condition="'$(MunariumRoot)' == ''">/opt/munarium</MunariumRoot></PropertyGroup></Project>
