# SPDX-License-Identifier: Apache-2.0
# Copy to .env.local only if that file does not exist. Never commit real keys.
# UTF-8 dotenv: one KEY=value per line, no export prefix, # comments on own lines.
# Leave unused keys empty; quote values containing spaces, # or $ with single quotes.
# Controlled fixtures need no keys and run no models. Real AI tests use all three online providers.
# These keys are passed only to Munarium Server, never to the Python application.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Preferred models for the distributed cloud tests (at least two cases per provider).
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENROUTER_MODEL=qwen/qwen3.8-flash
# These selectors remain available for a manual single-provider bootstrap.
INVOICE_PROVIDER=openai
INVOICE_MODEL=gpt-5.4-mini
